# Copy to .env in this directory (mcp/.env) — never commit .env
OPENAI_API_KEY=your_openai_api_key_here

# Same Chroma instance as the main app (docker-compose: port 8000)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=sushi_menu

OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
