{
  "mcpServers": {
    "sushi-rag-mcp": {
      "command": "python3",
      "args": [
        "/ABSOLUTE/PATH/TO/sushi-rag-app/mcp/server.py"
      ],
      "env": {
        "OPENAI_API_KEY": "sk-your-key-here",
        "CHROMA_HOST": "localhost",
        "CHROMA_PORT": "8000",
        "CHROMA_COLLECTION": "sushi_menu",
        "OPENAI_MODEL": "gpt-4o-mini",
        "EMBEDDING_MODEL": "text-embedding-3-small"
      }
    }
  }
}
